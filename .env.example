# Mapillary developer dashboard: https://www.mapillary.com/dashboard/developers
# Use the application's client access token.
MAPILLARY_ACCESS_TOKEN=

# OpenAI API platform: https://platform.openai.com/api-keys
# Used for frontage assessment, cached scale analysis, extraction and AI Enhance.
OPENAI_API_KEY=

# Extraction model. All image outputs use Medium.
OPENAI_IMAGE_MODEL=gpt-image-1.5

# Composition edits the scene to integrate perspective and lighting (Medium only).
OPENAI_COMPOSITION_MODEL=gpt-image-2
OPENAI_COMPOSITION_VISION_MODEL=gpt-4.1

# Dedicated low-cost model for automatic frontage selection (not composition).
OPENAI_FRONTAGE_MODEL=gpt-4.1-mini
# AI works locally and on Vercel whenever the required keys are configured.
# Optional emergency stop for both environments; shared daily limits still apply.
ENABLE_PAID_AI=true

# Optional Google comparison. Enable Places API (New) and Street View Static API
# on one Google Cloud project; keep this key server-side.
GOOGLE_MAPS_API_KEY=

# Supabase browser/server clients and cookie-based session refresh.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only credential for persistent project/planter data and private files.
# Never prefix this secret with NEXT_PUBLIC_ or commit an actual value.
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=storefront-assets

# Shared UTC-day limits: 20 extractions, 40 compositions, 200 vision assessments.
# Reservations use the existing private Supabase bucket; no new migration needed.
